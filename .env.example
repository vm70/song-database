# Example environment file for containerized deployments.

## MariaDB Requirements

MARIADB_USER=admin
MARIADB_PASSWORD_FILE=/run/secrets/mariadb-password
MARIADB_ROOT_PASSWORD_FILE=/run/secrets/mariadb-root-password
MARIADB_DATABASE=songdb

## Song Database Requirements

SONGDB__API__SHOW_REDOC=true
SONGDB__API__SHOW_DOCS=true
SONGDB__API__SHOW_OPENAPI_JSON=true

SONGDB__SQL__DRIVERNAME="mariadb+pymysql"
SONGDB__SQL__USERNAME="${MARIADB_USER}"
SONGDB__SQL__PASSWORD_FILE="${MARIADB_PASSWORD_FILE}"
SONGDB__SQL__HOST=mariadb
SONGDB__SQL__PORT=3306
SONGDB__SQL__DATABASE="${MARIADB_DATABASE}"
SONGDB__SQL__QUERY='{"charset": "utf8mb4"}'
SONGDB__SQL__QUIT_ON_FAILURE=true

SONGDB__AUTH__JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private-key
SONGDB__AUTH__JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public-key
SONGDB__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30