# MariaDB Requirements

MARIADB_USER=admin
MARIADB_DATABASE=songdb

# Song Database Requirements

SONGDB__SQL__DRIVERNAME="mariadb+pymysql"
SONGDB__SQL__USERNAME="${MARIADB_USER}"
SONGDB__SQL__HOST=mariadb
SONGDB__SQL__PASSWORD_FILE=secrets/songdb-mariadb-password
SONGDB__SQL__PORT=3306
SONGDB__SQL__DATABASE="${MARIADB_DATABASE}"
SONGDB__SQL__QUERY={}

SONGDB__AUTH__JWT_SECRET_FILE=secrets/songdb-auth-secret-key
SONGDB__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES = 30