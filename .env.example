# MariaDB Requirements

MARIADB_USER=admin
MARIADB_DATABASE=songdb

# Song Database Requirements

SONGDB__SQL__DRIVERNAME="mariadb+pymysql"
SONGDB__SQL__USERNAME="${MARIADB_USER}"
SONGDB__SQL__PASSWORD_FILE=/run/secrets/songdb-mariadb-password
SONGDB__SQL__PORT=3306
SONGDB__SQL__DATABASE="${MARIADB_DATABASE}"
SONGDB__SQL__QUERY='{"charset": "utf8mb4"}'

SONGDB__AUTH__JWT_PRIVATE_KEY_FILE=/run/secrets/songdb-auth-private-key.pem
SONGDB__AUTH__JWT_PUBLIC_KEY_FILE=/run/secrets/songdb-auth-public-key.pem
SONGDB__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES = 30