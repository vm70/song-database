# Example environment file for local testing.

## Song Database Requirements

SONGDB__API__SHOW_REDOC=true
SONGDB__API__SHOW_DOCS=true
SONGDB__API__SHOW_OPENAPI_JSON=true

SONGDB__SQL__URL_OVERRIDE="sqlite:///file:memdb1?mode=memory&cache=shared&uri=true"
SONGDB__SQL__CONNECT_ARGS='{"check_same_thread": false}'

SONGDB__AUTH__JWT_PRIVATE_KEY_FILE=./secrets/jwt-private-key.pem
SONGDB__AUTH__JWT_PUBLIC_KEY_FILE=./secrets/jwt-public-key.pem
SONGDB__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30